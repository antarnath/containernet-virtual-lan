# ContainerNet — development environment variables
# Copy this file to .env and edit as needed.
# In production, leave ADMIN_TOKEN unset (admin endpoints disable themselves).

# Admin token for /api/admin/* (development only; token-gated).
# Generate a random one: openssl rand -hex 16
ADMIN_TOKEN=devsecret

# Where the backend reaches the Docker daemon.
# Dev:    unix:///var/run/docker.sock (mount the socket in compose)
# Prod:   tcp://docker-proxy:2375 (use a socket proxy — see overview.md §22)
DOCKER_HOST=unix:///var/run/docker.sock
